# AWS Region
NEXT_PUBLIC_AWS_REGION=ap-northeast-2

# Cognito User Pool Configuration
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_USER_POOL_CLIENT_ID=

# Cognito Hosted UI Domain (REQUIRED)
NEXT_PUBLIC_COGNITO_DOMAIN=your-domain.auth.ap-northeast-2.amazoncognito.com
NEXT_PUBLIC_COGNITO_USER_POOL_CLIENT_SECRET=  # Optional - only if app client has a secret (confidential client)

# S3
NEXT_PUBLIC_S3_BUCKET=

# DynamoDB
NEXT_PUBLIC_DYNAMODB_TABLE=
DYNAMODB_WORKSPACE_TABLE=

# API Gateway / Lambda
NEXT_PUBLIC_API_ENDPOINT=

# Server-side AWS credentials (for API routes)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# OpenAI API (for vulnerability checks)
OPENAI_API_KEY=
